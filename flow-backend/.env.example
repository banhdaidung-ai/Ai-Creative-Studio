# ================================================
# Google Flow Backend — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# Google Account (tùy chọn — khuyến nghị nạp cookie qua sync_session_to_cloud.py)
GOOGLE_EMAIL=your_google_email@gmail.com
GOOGLE_PASSWORD=your_google_password

# Mã bảo mật Admin khi triển khai lên Oracle Cloud (dùng cho đồng bộ cookie & quản trị)
FLOW_ACCESS_TOKEN=

# Tự động cho phép người dùng Đăng nhập Google trên Firebase Auth (không cần nhập URL/Token)
FIREBASE_PROJECT_ID=ai-creative-studio-2026

# Tùy chọn lọc domain/email được phép (để trống = cho phép mọi tài khoản Google đã đăng nhập)
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Domain HTTPS cho Caddy trên Oracle Cloud (vd: 129-150-10-20.sslip.io hoặc flow.tenmiencuaban.com)
FLOW_DOMAIN=

# Danh sách Origin Frontend được phép CORS (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=https://ai-creative-studio-2026.web.app,https://ai-creative-studio-2026.firebaseapp.com,http://localhost:3000

# Frontend URL bổ sung (tùy chọn)
FRONTEND_URL=https://ai-creative-studio-2026.web.app

# Khóa endpoint /api/export-session trên Cloud (chỉ bật =true khi thật sự cần)
ALLOW_SESSION_EXPORT=false

# Thời gian lưu file cache tạm (giờ) trước khi janitor tự dọn
MEDIA_TTL_HOURS=24
JOB_TTL_HOURS=24

# Google AI API Key (tùy chọn — dùng để enhance prompt)
GOOGLE_AI_API_KEY=

# Server port (mặc định 8000)
PORT=8000
