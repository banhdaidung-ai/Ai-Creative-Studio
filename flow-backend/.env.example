# ================================================
# Google Flow Backend — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# Google Account (dùng lần đầu để đăng nhập — sau đó cookie được lưu lại)
GOOGLE_EMAIL=your_google_email@gmail.com
GOOGLE_PASSWORD=your_google_password

# Google AI API Key (tuỳ chọn — dùng để enhance prompt)
GOOGLE_AI_API_KEY=

# Frontend CORS origin
FRONTEND_URL=http://localhost:3000

# Server port (mặc định 8000)
PORT=8000
